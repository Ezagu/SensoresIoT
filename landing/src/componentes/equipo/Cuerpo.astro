---
// La caja: rótulo arriba, la grilla de sensores en el medio y la placa abajo,
// los tres del mismo ancho y alineados a la misma columna interior. Las
// ranuras vacías se dibujan siempre y muy tenues: marcan que queda lugar sin
// hacer ver el equipo incompleto.
import { INTERIOR, PLACA, RANURA, TOTAL_RANURAS, ranura } from './ranuras'

interface Props {
  // El hero mueve el LED por JS; el configurador no lo toca.
  haloId?: string
  ledId?: string
}
const { haloId, ledId } = Astro.props
const vacias = Array.from({ length: TOTAL_RANURAS }, (_, i) => ranura(i))
const derecha = INTERIOR.x + INTERIOR.ancho
---

<rect x="192" y="174" width="256" height="256" rx="18" class="body-fill ln ln-08" stroke-width="1.4"></rect>
<rect x="204" y="186" width="232" height="232" rx="12" class="ln ln-22" stroke-width="1"></rect>
<circle cx="214" cy="196" r="2.5" fill="currentColor" opacity="0.3"></circle>
<circle cx="426" cy="196" r="2.5" fill="currentColor" opacity="0.3"></circle>
<circle cx="214" cy="408" r="2.5" fill="currentColor" opacity="0.3"></circle>
<circle cx="426" cy="408" r="2.5" fill="currentColor" opacity="0.3"></circle>

<rect x={INTERIOR.x} y="200" width={INTERIOR.ancho} height="30" rx="5" class="ln ln-22" stroke-width="1"></rect>
<circle id={haloId} cx="240" cy="215" r="8" fill="var(--lp-ok)" class="led led-halo"></circle>
<circle id={ledId} cx="240" cy="215" r="3" fill="var(--lp-ok)" class="led"></circle>
<text x="255" y="219" style="font-size: 11px; user-select: none; letter-spacing: 0.16em; fill: currentColor; opacity: 0.65;">BITÁCORA</text>
<text x={derecha - 10} y="219" text-anchor="end" style="font-family: var(--font-mono); user-select: none; font-size: 9.5px; letter-spacing: 0.08em; fill: currentColor; opacity: 0.68;">B—01</text>

{vacias.map(([x, y]) => (
  <rect x={x} y={y} width={RANURA} height={RANURA} rx="12" class="ranura" stroke-width="1"></rect>
))}

<rect x={PLACA.x} y={PLACA.y} width={PLACA.w} height={PLACA.h} rx="6" class="ln ln-22" stroke-width="1.1"></rect>

<path d="M225 430v16h28v-16" class="ln ln-22" stroke-width="1.3"></path>
<path d="M240 446c0 22-38 26-38 48" class="ln ln-22" stroke-width="1.2"></path>
