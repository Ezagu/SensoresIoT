---
// Un solo glifo por módulo, usado por el chip del riel y por la celda adentro
// del equipo. Que sean el mismo dibujo es lo que hace que tocar un chip se lea
// como poner esa pieza en el gabinete.
interface Props {
  tipo: string
  clase?: string
  /** Para incrustarlo dentro del SVG del equipo; sin esto sale como ícono suelto. */
  x?: number
  y?: number
  lado?: number
}
const { tipo, clase, x, y, lado } = Astro.props

type Trazo = { d: string } | { c: [number, number, number] } | { r: [number, number, number, number, number] }

const ICONOS: Record<string, Trazo[]> = {
  temp: [{ d: 'M14 13.6V6.5a2 2 0 1 0-4 0v7.1a4 4 0 1 0 4 0Z' }, { d: 'M17 8h3M17 12h2' }],
  hum: [{ d: 'M12 3.6 7.9 8.5a6 6 0 1 0 8.2 0L12 3.6Z' }],
  co2: [
    { d: 'M3.5 8.5h6.8a2.6 2.6 0 1 0-2.6-2.6' },
    { d: 'M3.5 13.5h11.2a2.6 2.6 0 1 1-2.6 2.6' },
    { d: 'M3.5 18.5h5.6' },
  ],
  suelo: [
    { d: 'M12 20.5v-7.2' },
    { d: 'M12 13.3c0-3 1.9-4.9 4.9-4.9 0 3-1.9 4.9-4.9 4.9Z' },
    { d: 'M12 13.3c0-3-1.9-4.9-4.9-4.9 0 3 1.9 4.9 4.9 4.9Z' },
    { d: 'M4 20.5h16' },
  ],
  uv: [
    { c: [12, 12, 3.6] },
    { d: 'M12 3.5v1.8M12 18.7v1.8M3.5 12h1.8M18.7 12h1.8M6.2 6.2l1.3 1.3M16.5 16.5l1.3 1.3M17.8 6.2l-1.3 1.3M7.5 16.5l-1.3 1.3' },
  ],
  pres: [{ c: [12, 13, 7.5] }, { d: 'M12 13l4.2-3.4M12 5.5v1.4' }],
  bat: [{ r: [3, 8, 15, 9, 2.5] }, { d: 'M21 11.2v2.6M7 11v3M11 11v3' }],
  solar: [{ r: [3, 5, 18, 10, 1.5] }, { d: 'M3 10h18M9 5v10M15 5v10M12 15v4M8.5 19h7' }],
  lora: [
    { c: [12, 12, 2] },
    { d: 'M8.6 8.6a4.8 4.8 0 0 0 0 6.8M15.4 8.6a4.8 4.8 0 0 1 0 6.8' },
    { d: 'M5.9 5.9a8.6 8.6 0 0 0 0 12.2M18.1 5.9a8.6 8.6 0 0 1 0 12.2' },
  ],
  gw: [{ r: [4, 13, 16, 7, 2] }, { d: 'M12 13V4M8.5 7a5 5 0 0 1 7 0' }],
}

const trazos = ICONOS[tipo] ?? []
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  class={clase}
  x={x}
  y={y}
  width={lado}
  height={lado}
  aria-hidden="true"
>
  {trazos.map((t) => (
    'd' in t ? <path d={t.d}></path>
    : 'c' in t ? <circle cx={t.c[0]} cy={t.c[1]} r={t.c[2]}></circle>
    : <rect x={t.r[0]} y={t.r[1]} width={t.r[2]} height={t.r[3]} rx={t.r[4]}></rect>
  ))}
</svg>
