---
// El segundo equipo que entra con LoRa. Coordenadas propias y absolutas: es
// una unidad fija, no se reacomoda como los módulos del gabinete.
// Lleva la misma antena que el equipo, del lado que mira hacia él.
// Adentro, las dos radios como celdas — el mismo vocabulario que los sensores.
import Icono from './Icono.astro'

interface Props {
  id?: string
}
const { id = 'unit-gw' } = Astro.props
---

<g id={id} class="unit-gw">
  <path d="M580.5 183.5a3.5 3.5 0 0 1 7 0L590 370a6 6 0 0 1-12 0Z" class="body-fill ln ln-45" stroke-width="1.3"></path>
  <rect x="576" y="370" width="26" height="16" rx="4" class="plate-fill ln ln-45" stroke-width="1.2"></rect>

  <rect x="602" y="330" width="140" height="116" rx="14" class="body-fill ln ln-08" stroke-width="1.6"></rect>
  <rect x="612" y="340" width="120" height="96" rx="9" class="ln ln-22" stroke-width="1"></rect>

  <rect x="622" y="350" width="100" height="22" rx="4" class="ln ln-22" stroke-width="1"></rect>
  <text x="672" y="365" text-anchor="middle" style="font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.08em; fill: currentColor; opacity: 0.3;">GW—01</text>

  <rect x="622" y="382" width="44" height="44" rx="10" class="ln ln-45" stroke-width="1.2"></rect>
  <Icono tipo="lora" x={632} y={392} lado={24} clase="ico-mod" />
  <rect x="678" y="382" width="44" height="44" rx="10" class="ln ln-45" stroke-width="1.2"></rect>
  <Icono tipo="gw" x={688} y={392} lado={24} clase="ico-mod" />

  <text x="602" y="470" class="tag-fijo">GATEWAY LORA</text>
</g>
