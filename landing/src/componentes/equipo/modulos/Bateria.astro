---
import type { Props } from './props'
import { SEPARACION } from '../ranuras'
const [ex, ey] = SEPARACION.bat
const { id, activo = false, x = 122, y = 280 } = Astro.props
---

<g id={id} class:list={['mod', 'p-bat', { on: activo }]} style={`--ex:${ex}px;--ey:${ey}px`}>
  <g data-pos transform={`translate(${x} ${y})`}>
    <!-- el borne va abierto abajo: contra el techo de la carcasa, un rect cerrado deja dos líneas pegadas -->
    <path d="M19 8V3a3 3 0 0 1 3-3h18a3 3 0 0 1 3 3v5" class="ln ln-45" stroke-width="1.2"></path>
    <rect y="8" width="62" height="108" rx="11" class="plate-fill ln ln-45" stroke-width="1.3"></rect>
    <rect x="8" y="20" width="46" height="18" rx="3" class="ln ln-22" stroke-width="1.2"></rect>
    <rect x="8" y="42" width="46" height="18" rx="3" class="ln ln-22" stroke-width="1.2"></rect>
    <rect x="8" y="64" width="46" height="18" rx="3" class="ln ln-22" stroke-width="1.2"></rect>
    <rect x="8" y="86" width="46" height="18" rx="3" class="ln ln-22" stroke-width="1.2"></rect>
  </g>
</g>
