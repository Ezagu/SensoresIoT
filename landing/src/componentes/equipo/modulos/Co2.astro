---
import type { Props } from './props'
import Icono from '../Icono.astro'
import { RANURA, ranuraDe, EXPLOSION } from '../ranuras'
const [rx, ry] = ranuraDe('co2')
const [ex, ey] = EXPLOSION.co2
const { id, activo = false, x = rx, y = ry } = Astro.props
---

<g id={id} class:list={['mod', 'p-co2', { on: activo }]} style={`--ex:${ex}px;--ey:${ey}px`}>
  <g data-pos transform={`translate(${x} ${y})`}>
    <rect width={RANURA} height={RANURA} rx="12" class="celda ln ln-45" stroke-width="1.2"></rect>
    <Icono tipo="co2" x={15} y={15} lado={28} clase="ico-mod" />
  </g>
</g>
