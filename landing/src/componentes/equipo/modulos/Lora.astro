---
import type { Props } from './props'
import { SEPARACION } from '../ranuras'
const [ex, ey] = SEPARACION.lora
const { id, activo = false, x = 448, y = 160 } = Astro.props
---

<g id={id} class:list={['mod', 'p-lora', { on: activo }]} style={`--ex:${ex}px;--ey:${ey}px`}>
  <g data-pos transform={`translate(${x} ${y})`}>
    <!-- el mástil se afina hacia la punta: 12 en la base, 7 arriba -->
    <path d="M14.5 23.5a3.5 3.5 0 0 1 7 0L24 210a6 6 0 0 1-12 0Z" class="body-fill ln ln-45" stroke-width="1.3"></path>
    <rect y="210" width="26" height="16" rx="4" class="plate-fill ln ln-45" stroke-width="1.2"></rect>
  </g>
</g>
