---
import type { Props } from './props'
import { EXPLOSION } from '../ranuras'
const [ex, ey] = EXPLOSION.solar
const { id, activo = false, conEtiqueta = false, x = 224, y = 108 } = Astro.props
---

<g id={id} class:list={['mod', 'p-solar', { on: activo }]} style={`--ex:${ex}px;--ey:${ey}px`}>
  <g data-pos transform={`translate(${x} ${y})`}>
    <rect width="192" height="32" rx="6" class="plate-fill ln ln-45" stroke-width="1.3"></rect>
    <path d="M0 16h192M48 0v32M96 0v32M144 0v32" class="ln ln-22" stroke-width="1"></path>
    <path d="M96 32v32M72 64h48" class="ln ln-45" stroke-width="1.3"></path>
    {conEtiqueta && <text x="0" y="-10" class="tag">PANEL SOLAR</text>}
  </g>
</g>
