---
// Fuente: Main.dc.html:733-769. Sin `data-theme` en `.lp` (vive en <html>,
// ver estilos/tokens.css) y sin los dos `sc-if` de íconos: los dos SVG están
// siempre en el DOM y nav.css los alterna por `html[data-theme]`.
---

<header class="top">
  <div class="top-in">
    <a href="#top" class="mark">
      <span class="tick"></span>
      <span class="name">BITÁCORA</span>
      <span class="sub">guardia ambiental</span>
    </a>
    <span class="top-right">
      <a href="#equipo" class="top-link">Armá tu equipo</a>
      <a href="#planes" class="top-link">Planes</a>
      <a href="#preguntas" class="top-link">Preguntas</a>
      <button type="button" id="btn-tema" class="modo" aria-pressed="true" aria-label="Cambiar a modo claro" title="Cambiar a modo claro">
        <svg class="ico-luna" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4.2"></circle><path d="M12 3v2.2M12 18.8V21M3 12h2.2M18.8 12H21M5.6 5.6l1.6 1.6M16.8 16.8l1.6 1.6M18.4 5.6l-1.6 1.6M7.2 16.8l-1.6 1.6"></path></svg>
        <svg class="ico-sol" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.2A8.4 8.4 0 0 1 9.8 4a8.4 8.4 0 1 0 10.2 10.2Z"></path></svg>
      </button>
      <a href="#equipo" class="cta cta-solid cta-sm">Empezar</a>
      <button type="button" id="btn-menu" class="menu-btn" aria-expanded="false" aria-label="Abrir el menú" aria-controls="menu-secciones">
        <span class="bar"></span>
        <span class="bar"></span>
      </button>
    </span>
  </div>
  <nav id="menu-secciones" class="menu-panel" aria-label="Secciones" inert>
    <div>
      <a href="#equipo">Armá tu equipo<span class="flechita">→</span></a>
      <a href="#guardia">Cómo trabaja<span class="flechita">→</span></a>
      <a href="#planes">Planes<span class="flechita">→</span></a>
      <a href="#preguntas">Preguntas<span class="flechita">→</span></a>
      <a href="#contacto">Contacto<span class="flechita">→</span></a>
    </div>
  </nav>
</header>

<script>
  import '../../scripts/tema'
  import '../../scripts/nav'
</script>
