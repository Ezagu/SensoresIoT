---
// El hero es el momento del aviso: en el celular la temperatura cruza el
// umbral y entra la notificación. El HTML es el primer cuadro de la demo en
// vivo (con el aviso a la vista), así sin JS o con reduced-motion se entiende
// igual; scripts/hero.ts la pone en marcha desde ahí.
import PastillaEstado from '../datos/PastillaEstado.astro'
import MarcaEstado from '../datos/MarcaEstado.astro'
import IconoCanal from '../datos/IconoCanal.astro'
import { MUESTRA_INICIAL, UMBRAL, VISTA, Y_UMBRAL, evaluadorHasta, trazoEn, valorDe } from '../../datos/hero'

const fmt = new Intl.NumberFormat('es-AR', { minimumFractionDigits: 1, maximumFractionDigits: 1 })
const { puntos, punta } = trazoEn(MUESTRA_INICIAL)
const alerta = evaluadorHasta(MUESTRA_INICIAL).estado === 'alerta'
---

<section id="top" class="band hero stage">
  <div class="hero-grid">
    <div class="hero-copy">
      <h1 class="display"><span class="soft">Medimos tu ambiente.</span><br>Si algo se sale de rango, te avisamos.</h1>
      <p class="note">Los sensores que necesites, en el ambiente que quieras, con todas las mediciones en tu celular o tu computadora.</p>
      <ul class="hero-pilares">
        <li>Aviso al instante</li>
        <li>Informes para auditoría</li>
        <li>Armado a medida</li>
      </ul>
      <div class="hero-actions">
        <a href="#equipo" class="cta cta-solid">Armá tu equipo</a>
        <a href="#avisos" class="cta cta-line">Ver cómo funciona</a>
      </div>
    </div>

    <div class="hero-escena">
      <figure class="hero-foto">
        <!-- TODO(landing): reemplazar el marco por la foto real del equipo (<img>) -->
        <div class="hero-foto__marco" role="img" aria-label="Foto del equipo">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 8h3l1.6-2.4h6.8L17 8h3v11H4z"></path><circle cx="12" cy="13" r="3.6"></circle></svg>
          <span>Foto del equipo</span>
        </div>
        <figcaption class="micro">El equipo · mide cada 15 s</figcaption>
      </figure>

      <div id="tel" class={`tel ${alerta ? 'es-alerta' : ''}`} role="img" aria-label={`En la app, la temperatura de Cámara 1 sube, cruza el umbral de ${fmt.format(UMBRAL)} °C y llega el aviso al celular.`}>
        <div class="tel-pantalla" aria-hidden="true">
          <div class="tel-barra"><span>17:15</span><span class="tel-isla"></span><span class="tel-bat"></span></div>

          <!-- en el mismo lugar donde cae el aviso: mientras todo está en rango, lo dice -->
          <div class="tel-estado">
            <span class="tel-estado__icono">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12.5 4.5 4.5L19 7.5"></path></svg>
            </span>
            <div>
              <div class="tel-estado__tit">Todo en rango</div>
              <div class="tel-estado__sub">Si pasa de {fmt.format(UMBRAL)} °C, te avisamos.</div>
            </div>
          </div>

          <div id="tel-aviso" class={`tel-aviso ${alerta ? 'on' : ''}`} data-canal="mail">
            <span class="tel-aviso__icono">
              <IconoCanal canal="mail" marcado />
              <IconoCanal canal="whatsapp" marcado />
              <IconoCanal canal="telegram" marcado />
            </span>
            <div class="tel-aviso__txt">
              <div class="tel-aviso__cab"><b data-canal="mail">Mail</b><b data-canal="whatsapp">WhatsApp</b><b data-canal="telegram">Telegram</b><span>ahora</span></div>
              <div class="tel-aviso__tit"><MarcaEstado estado="critical" />Cámara 1 superó {fmt.format(UMBRAL)} °C</div>
              <div class="tel-aviso__cuerpo">Temperatura fuera de rango · Depósito norte</div>
            </div>
          </div>

          <div class="tel-app">
            <div class="tel-cab">
              <div>
                <div class="tel-nombre">Cámara 1</div>
                <div class="tel-lugar">Depósito norte</div>
              </div>
              <PastillaEstado id="tel-normal" estado="normal" etiqueta="En línea" pill hidden={alerta} />
              <PastillaEstado id="tel-alerta" estado="critical" etiqueta="Alerta" pill hidden={!alerta} />
            </div>

            <div class="tel-lectura read">
              <span id="tel-valor" class="tel-valor">{fmt.format(valorDe(MUESTRA_INICIAL))}</span><span class="tel-unidad">°C</span>
            </div>
            <div class="tel-rotulo micro"><span class="tel-vivo"></span>Temperatura · en vivo</div>

            <div class="tel-graf">
              <svg viewBox={`0 0 ${VISTA.ancho} ${VISTA.alto}`} fill="none">
                <defs>
                  <!-- un mismo trazo, pintado distinto arriba y abajo del umbral -->
                  <clipPath id="tel-arriba" clipPathUnits="userSpaceOnUse">
                    <rect x="0" y="0" width={VISTA.ancho} height={Y_UMBRAL}></rect>
                  </clipPath>
                  <clipPath id="tel-abajo" clipPathUnits="userSpaceOnUse">
                    <rect x="0" y={Y_UMBRAL} width={VISTA.ancho} height={VISTA.alto - Y_UMBRAL}></rect>
                  </clipPath>
                </defs>
                <rect class="tel-zona" x="0" y="0" width={VISTA.ancho} height={Y_UMBRAL}></rect>
                <line class="tel-guia" x1="0" y1={VISTA.alto * 0.62} x2={VISTA.ancho} y2={VISTA.alto * 0.62}></line>
                <line class="tel-guia" x1="0" y1={VISTA.alto - 1} x2={VISTA.ancho} y2={VISTA.alto - 1}></line>
                <line class="tel-umbral" x1="0" y1={Y_UMBRAL} x2={VISTA.ancho} y2={Y_UMBRAL}></line>
                <text class="tel-umbral-txt" x="4" y={Y_UMBRAL - 5}>umbral {fmt.format(UMBRAL)} °C</text>
                <polyline id="tel-trazo-abajo" class="tel-calma" clip-path="url(#tel-abajo)" points={puntos}></polyline>
                <polyline id="tel-trazo-arriba" class="tel-sube" clip-path="url(#tel-arriba)" points={puntos}></polyline>
                <circle id="tel-punta" class={`tel-punta ${punta[1] < Y_UMBRAL ? 'arriba' : ''}`} cx={punta[0]} cy={punta[1]} r="4"></circle>
              </svg>
            </div>
          </div>

          <span class="tel-home"></span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import '../../scripts/hero'
</script>
