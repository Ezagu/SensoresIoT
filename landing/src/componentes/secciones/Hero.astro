---
// Fuente: Main.dc.html:770-897. La demo de 4 fases (normal/espera/descarga/
// alerta) la maneja scripts/hero.ts. Cambios respecto del mockup:
// - se saca el style="opacity:1" inline que pisaba la animación .rise (bug,
//   ver PENDIENTES-DEEPSLEEP.md — no, ver plan de la landing);
// - el ciclo se gatea por IntersectionObserver + document.hidden en vez de
//   correr para siempre;
// - viewBox, aria-label, fill de los LEDs y los textos de estado se fijan
//   por id en vez de por interpolación de template.
// El equipo sale de componentes/equipo/, compartido con el configurador; lo
// que queda acá es sólo la maquinaria de la demo (destello, cola y flujo).
import Cuerpo from '../equipo/Cuerpo.astro'
import Lora from '../equipo/modulos/Lora.astro'
import Temperatura from '../equipo/modulos/Temperatura.astro'
import Humedad from '../equipo/modulos/Humedad.astro'
import Co2 from '../equipo/modulos/Co2.astro'
import { PLACA } from '../equipo/ranuras'
import { COLA_MAX } from '../../datos/config'

// La cola ocupa la placa entera y se llena de izquierda a derecha: el primer
// lugar es el primero que se ve. PLACA sale de equipo/ranuras.ts.
const MARGEN = 17
const paso = (PLACA.w - MARGEN * 2) / (COLA_MAX - 1)
const cola = Array.from({ length: COLA_MAX }, (_, i) => PLACA.x + MARGEN + paso * i)
---

<section id="top" class="band hero stage">
  <div class="hero-grid">
    <div class="hero-copy">
      <h1 class="display"><span class="soft">Vos seguís con tu día.</span><br>Nosotros miramos el ambiente.</h1>
      <p class="note">Un equipo armado con los sensores que necesitás, midiendo donde te importa. Mientras todo esté en rango, no vas a saber que está ahí.</p>
      <div class="hero-actions">
        <a href="#equipo" class="cta cta-solid">Armá tu equipo</a>
        <a href="#guardia" class="cta cta-line">Ver cómo trabaja</a>
      </div>
    </div>

    <div class="hero-dev-wrap">
      <div id="estado-card" class="estado-card is-normal sw-a">
        <span class="e-dot"></span>
        <div>
          <div id="estado-titulo" class="e-t">En línea</div>
          <div id="estado-sub" class="e-s">Todo en orden</div>
        </div>
        <span id="estado-avisa" class="e-avisa" role="img" aria-label="Avisándote" hidden>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <g class="campana">
              <path d="M6.4 16.4c.7-.9 1-1.6 1-3.3v-2.3a4.6 4.6 0 1 1 9.2 0v2.3c0 1.7.3 2.4 1 3.3z"></path>
              <path d="M10.1 19.2a2.1 2.1 0 0 0 3.8 0"></path>
            </g>
            <path class="onda" d="M19.4 6.1a7.2 7.2 0 0 1 1.9 3.6"></path>
            <path class="onda o2" d="M4.6 6.1a7.2 7.2 0 0 0-1.9 3.6"></path>
          </svg>
        </span>
      </div>

      <svg id="hero-svg" class="device hero-dev f-normal rise" viewBox="147 150 384 358" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Las mediciones viajan de los sensores al equipo y salen por la antena LoRa">
        <Lora activo />
        <Cuerpo haloId="hero-led-halo" ledId="hero-led-dot" />

        <!-- la placa respira en rojo mientras el equipo detecta una alerta -->
        <rect class="nucleo-alerta" x="216" y="372" width="208" height="34" rx="10" fill="none" stroke="var(--lp-warn-mark)" stroke-width="1.3"></rect>

        <!-- cola de transmisión, sobre la placa -->
        <!-- los lugares vacíos se ven siempre: la placa nunca queda en blanco -->
        <g class="buffer">
          {cola.map((cx) => <circle class="buf-hueco" cx={cx} cy="389" r="2"></circle>)}
          {cola.map((cx, i) => (
            <circle id={`buf-${i + 1}`} class="buf" cx={cx} cy="389" r="3.2"></circle>
          ))}
        </g>

        <Temperatura activo />
        <Humedad activo />
        <Co2 activo />

        <!-- las que entran son un loop de CSS; las que salen las emite
             scripts/hero.ts, una por envío -->
        <g class="flujo" aria-hidden="true">
          <circle class="dot dot-in d-temp" r="3"></circle>
          <circle class="dot dot-in d-temp r2" r="3"></circle>
          <circle class="dot dot-in d-temp r3" r="3"></circle>
          <circle class="dot dot-in d-hum" r="3"></circle>
          <circle class="dot dot-in d-hum r2" r="3"></circle>
          <circle class="dot dot-in d-hum r3" r="3"></circle>
          <circle class="dot dot-in d-co2" r="3"></circle>
          <circle class="dot dot-in d-co2 r2" r="3"></circle>
        </g>
      </svg>

    </div>
  </div>

</section>

<script>
  import '../../scripts/hero'
</script>
