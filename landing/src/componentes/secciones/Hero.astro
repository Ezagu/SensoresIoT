---
// Fuente: Main.dc.html:770-897. La demo de 4 fases (normal/espera/descarga/
// alerta) la maneja scripts/hero.ts. Cambios respecto del mockup:
// - se saca el style="opacity:1" inline que pisaba la animación .rise (bug,
//   ver PENDIENTES-DEEPSLEEP.md — no, ver plan de la landing);
// - el ciclo se gatea por IntersectionObserver + document.hidden en vez de
//   correr para siempre;
// - viewBox, aria-label, fill de los LEDs y los textos de estado se fijan
//   por id en vez de por interpolación de template.
---

<section id="top" class="band hero stage">
  <div class="hero-grid">
    <div class="hero-copy">
      <h1 class="display">Vos seguís con tu día.<br><span class="soft">Nosotros miramos el ambiente.</span></h1>
      <p class="note">Un equipo armado con los sensores que necesitás, midiendo donde te importa. Mientras todo esté en rango, no vas a saber que está ahí.</p>
      <div class="hero-actions">
        <a href="#equipo" class="cta cta-solid">Armá tu equipo</a>
        <a href="#guardia" class="cta cta-line">Ver cómo trabaja</a>
      </div>
    </div>

    <div class="hero-dev-wrap">
      <svg id="hero-svg" class="device hero-dev f-normal rise" viewBox="0 0 620 560" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Las mediciones viajan de los sensores al equipo y salen por la antena wi-fi">
        <ellipse cx="310" cy="500" rx="180" ry="14" fill="currentColor" opacity="0.06"></ellipse>
        <rect x="168" y="150" width="284" height="266" rx="16" class="plate-fill ln ln-22" stroke-width="1"></rect>
        <path d="M186 168h12M422 168h12M186 398h12M422 398h12" class="ln ln-22" stroke-width="1"></path>

        <!-- antena wi-fi: siempre incluida -->
        <g class="antena">
          <path d="M406 176l46-52" class="ln ln-45" stroke-width="1.5"></path>
          <path d="M436 142h20M444 158h16" class="ln ln-22" stroke-width="1.2"></path>
          <circle cx="452" cy="118" r="5.5" class="ln ln-08" stroke-width="1.4"></circle>
          <g class="ondas">
            <path d="M462 106a20 20 0 0 1 11 13" class="wifi-wave"></path>
            <path d="M470 92a36 36 0 0 1 19 23" class="wifi-wave"></path>
            <path d="M478 78a52 52 0 0 1 27 33" class="wifi-wave"></path>
          </g>
        </g>

        <g class="mod p-bat on">
          <rect x="74" y="238" width="86" height="130" rx="12" class="plate-fill ln ln-45" stroke-width="1.3"></rect>
          <path d="M92 266h50M92 288h50M92 310h30" class="ln ln-22" stroke-width="1.2"></path>
          <path d="M160 288h22M160 318h22" class="ln ln-45" stroke-width="1.3"></path>
        </g>

        <rect x="192" y="174" width="236" height="218" rx="18" class="body-fill ln ln-08" stroke-width="1.6"></rect>
        <rect x="204" y="186" width="212" height="194" rx="12" class="ln ln-22" stroke-width="1"></rect>
        <path d="M222 356h84M222 368h52" class="ln ln-22" stroke-width="1.4" stroke-linecap="round"></path>
        <circle cx="214" cy="196" r="2.5" fill="currentColor" opacity="0.32"></circle>
        <circle cx="406" cy="196" r="2.5" fill="currentColor" opacity="0.32"></circle>
        <circle cx="214" cy="370" r="2.5" fill="currentColor" opacity="0.32"></circle>
        <circle cx="406" cy="370" r="2.5" fill="currentColor" opacity="0.32"></circle>
        <rect x="222" y="206" width="120" height="30" rx="4" class="ln ln-22" stroke-width="1"></rect>
        <text x="234" y="226" style="font-size: 11px; letter-spacing: 0.16em; fill: currentColor; opacity: 0.5;">BITÁCORA</text>
        <text x="352" y="226" style="font-family: var(--font-mono); font-size: 10px; fill: currentColor; opacity: 0.35;">B—01</text>
        <circle id="hero-led-halo" cx="394" cy="222" r="13" fill="var(--lp-ok)" class="led led-halo"></circle>
        <circle id="hero-led-dot" cx="394" cy="222" r="5" fill="var(--lp-ok)" class="led"></circle>
        <path d="M296 392v16h28v-16" class="ln ln-45" stroke-width="1.3"></path>
        <path d="M310 408c0 26-42 30-42 56" class="ln ln-22" stroke-width="1.2"></path>

        <!-- núcleo de procesamiento -->
        <rect x="272" y="262" width="64" height="52" rx="8" class="ln ln-45" stroke-width="1.2"></rect>
        <rect x="284" y="274" width="40" height="28" rx="4" class="ln ln-22" stroke-width="1"></rect>
        <path d="M272 276h-12M272 292h-12M336 276h12M336 292h12M290 262v-10M318 262v-10M290 314v10M318 314v10" class="ln ln-22" stroke-width="1.1"></path>
        <circle class="nucleo-flash" cx="304" cy="288" r="42" fill="none" stroke="var(--lp-warn-mark)" stroke-width="1.3"></circle>

        <!-- cola de transmisión -->
        <g class="buffer">
          <circle id="buf-1" class="buf" cx="268" cy="336" r="3.6"></circle>
          <circle id="buf-2" class="buf" cx="284" cy="336" r="3.6"></circle>
          <circle id="buf-3" class="buf" cx="300" cy="336" r="3.6"></circle>
          <circle id="buf-4" class="buf" cx="316" cy="336" r="3.6"></circle>
        </g>

        <g class="mod p-temp on">
          <rect x="428" y="208" width="58" height="60" rx="12" class="body-fill ln ln-45" stroke-width="1.3"></rect>
          <path d="M442 226h30M442 240h30" class="ln ln-22" stroke-width="1.2"></path>
        </g>
        <g class="mod p-hum on">
          <rect x="428" y="278" width="58" height="60" rx="12" class="body-fill ln ln-45" stroke-width="1.3"></rect>
          <circle cx="457" cy="308" r="12" class="ln ln-22" stroke-width="1.2"></circle>
        </g>
        <g class="mod p-co2 on">
          <rect x="236" y="400" width="148" height="52" rx="12" class="body-fill ln ln-45" stroke-width="1.3"></rect>
          <circle cx="272" cy="426" r="13" class="ln ln-45" stroke-width="1.2"></circle>
          <path d="M300 418h64M300 432h42" class="ln ln-22" stroke-width="1.2"></path>
        </g>

        <!-- mediciones viajando -->
        <g class="flujo" aria-hidden="true">
          <circle class="dot dot-in d-temp" r="3.6"></circle>
          <circle class="dot dot-in d-temp r2" r="3.6"></circle>
          <circle class="dot dot-in d-temp r3" r="3.6"></circle>
          <circle class="dot dot-in d-hum" r="3.6"></circle>
          <circle class="dot dot-in d-hum r2" r="3.6"></circle>
          <circle class="dot dot-in d-hum r3" r="3.6"></circle>
          <circle class="dot dot-in d-co2" r="3.6"></circle>
          <circle class="dot dot-in d-co2 r2" r="3.6"></circle>
          <circle class="dot dot-out" r="3.6"></circle>
          <circle class="dot dot-out o2" r="3.6"></circle>
        </g>
      </svg><div id="estado-card" class="estado-card is-normal sw-a">
        <span class="e-dot"></span>
        <div>
          <div id="estado-titulo" class="e-t">En línea</div>
          <div id="estado-sub" class="e-s">Todo en orden</div>
        </div>
        <span id="estado-avisa" class="e-avisa" role="img" aria-label="Avisándote" hidden>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <g class="campana">
              <path d="M6.4 16.4c.7-.9 1-1.6 1-3.3v-2.3a4.6 4.6 0 1 1 9.2 0v2.3c0 1.7.3 2.4 1 3.3z"></path>
              <path d="M10.1 19.2a2.1 2.1 0 0 0 3.8 0"></path>
            </g>
            <path class="onda" d="M19.4 6.1a7.2 7.2 0 0 1 1.9 3.6"></path>
            <path class="onda o2" d="M4.6 6.1a7.2 7.2 0 0 0-1.9 3.6"></path>
          </svg>
        </span>
      </div>
    </div>
  </div>

  <div class="hero-foot">
    <span class="micro">Cámara 1 · Depósito norte</span>
    <span class="live read"><span id="hero-temp" class="v">0,0</span><span class="u">°C</span></span>
    <span class="sep"></span>
    <span class="micro">rango 2,0 — 8,0 °C</span>
    <span class="sep"></span>
    <span id="hero-desde" class="micro">última lectura hace 4 s</span>
  </div>
</section>

<script>
  import '../../scripts/hero'
</script>
