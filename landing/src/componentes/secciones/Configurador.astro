---
// Fuente: Main.dc.html:933-1157. La lógica de selección, precio y marco()
// vive en scripts/configurador.ts + scripts/marco.ts. Temperatura y
// Humedad muestran "GRATIS" fijo en el markup original (no interpolan
// precio): se mantiene así, nunca cambian de precio.
---

<div class="band-alt">
  <section id="equipo" class="build stage">
    <div class="build-head">
      <h2 class="say">Armá el equipo<br>que necesitás.</h2>
      <p style="font-size: 13px; color: var(--lp-faint); max-width: 30ch; line-height: 1.6;">Cada módulo con su precio. El equipo y el total se arman acá mismo.</p>
    </div>

    <div class="build-grid">
      <div id="rail-sensores" class="rail rail-sensores">
        <div class="rail-h"><span>Sensores</span><span>USD</span></div>
        <div class="chips">
          <button type="button" id="chip-temp" class="chip" aria-pressed="false" data-modulo="temp">
            <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M14 13.6V6.5a2 2 0 1 0-4 0v7.1a4 4 0 1 0 4 0Z"></path><path d="M17 8h3M17 12h2"></path></svg>
            <span class="txt"><span class="nm">Temperatura</span><span class="un">°C</span></span>
            <span class="pr">GRATIS</span>
          </button>
          <button type="button" id="chip-hum" class="chip" aria-pressed="false" data-modulo="hum">
            <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M12 3.6 7.9 8.5a6 6 0 1 0 8.2 0L12 3.6Z"></path></svg>
            <span class="txt"><span class="nm">Humedad</span><span class="un">% HR</span></span>
            <span class="pr">GRATIS</span>
          </button>
          <button type="button" id="chip-co2" class="chip" aria-pressed="false" data-modulo="co2">
            <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M3.5 8.5h6.8a2.6 2.6 0 1 0-2.6-2.6"></path><path d="M3.5 13.5h11.2a2.6 2.6 0 1 1-2.6 2.6"></path><path d="M3.5 18.5h5.6"></path></svg>
            <span class="txt"><span class="nm">CO₂</span><span class="un">ppm</span></span>
            <span id="pr-co2" class="pr">+ US$ 45</span>
          </button>
          <button type="button" id="chip-suelo" class="chip" aria-pressed="false" data-modulo="suelo">
            <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M12 20.5v-7.2"></path><path d="M12 13.3c0-3 1.9-4.9 4.9-4.9 0 3-1.9 4.9-4.9 4.9Z"></path><path d="M12 13.3c0-3-1.9-4.9-4.9-4.9 0 3 1.9 4.9 4.9 4.9Z"></path><path d="M4 20.5h16"></path></svg>
            <span class="txt"><span class="nm">Humedad de suelo</span><span class="un">% vol</span></span>
            <span id="pr-suelo" class="pr">+ US$ 18</span>
          </button>
          <button type="button" id="chip-uv" class="chip" aria-pressed="false" data-modulo="uv">
            <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="3.6"></circle><path d="M12 3.5v1.8M12 18.7v1.8M3.5 12h1.8M18.7 12h1.8M6.2 6.2l1.3 1.3M16.5 16.5l1.3 1.3M17.8 6.2l-1.3 1.3M7.5 16.5l-1.3 1.3"></path></svg>
            <span class="txt"><span class="nm">Radiación UV</span><span class="un">índice</span></span>
            <span id="pr-uv" class="pr">+ US$ 14</span>
          </button>
          <button type="button" id="chip-pres" class="chip" aria-pressed="false" data-modulo="pres">
            <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="13" r="7.5"></circle><path d="M12 13l4.2-3.4M12 5.5v1.4"></path></svg>
            <span class="txt"><span class="nm">Presión</span><span class="un">hPa</span></span>
            <span id="pr-pres" class="pr">+ US$ 12</span>
          </button>
        </div>
      </div>

      <div class="build-stage">
        <div class="stage-frame">
          <div class="stage-top">
            <span id="equipo-id" class="id">B—01 · equipo base</span>
            <button type="button" id="btn-explode" class="ex" aria-pressed="false">Vista explotada</button>
          </div>

          <svg id="equipo-svg" class="device" viewBox="0 0 780 600" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Tu equipo con los módulos elegidos">
            <g id="equipo-outer">
              <g class="unit-main">
                <ellipse cx="310" cy="500" rx="180" ry="14" fill="currentColor" opacity="0.05"></ellipse>
                <rect x="168" y="150" width="284" height="266" rx="16" class="plate-fill ln ln-22" stroke-width="1"></rect>
                <path d="M186 168h12M422 168h12M186 398h12M422 398h12" class="ln ln-22" stroke-width="1"></path>

                <g id="mod-solar" class="mod p-solar">
                  <rect x="150" y="34" width="320" height="76" rx="6" class="plate-fill ln ln-45" stroke-width="1.3"></rect>
                  <path d="M150 72h320M230 34v76M310 34v76M390 34v76" class="ln ln-22" stroke-width="1"></path>
                  <path d="M310 110v34M286 144h48" class="ln ln-45" stroke-width="1.3"></path>
                  <text x="150" y="26" class="tag">PANEL SOLAR</text>
                </g>
                <g id="mod-lora" class="mod p-lora">
                  <path d="M432 172l46-44" class="ln ln-45" stroke-width="1.4"></path>
                  <circle cx="482" cy="124" r="6" class="ln ln-08" stroke-width="1.4"></circle>
                  <path d="M460 108a30 30 0 0 1 18 18" class="ln ln-22" stroke-width="1.1"></path>
                  <text x="446" y="160" class="tag">RADIO LORA</text>
                </g>
                <g id="mod-cel" class="mod p-cel">
                  <rect x="458" y="300" width="20" height="54" rx="6" class="plate-fill ln ln-45" stroke-width="1.2"></rect>
                  <path d="M486 342v-8M494 342v-18M502 342v-28" class="ln ln-45" stroke-width="1.6" stroke-linecap="round"></path>
                  <text x="458" y="376" class="tag">CELULAR</text>
                </g>
                <g id="mod-bat" class="mod p-bat">
                  <rect x="74" y="238" width="86" height="130" rx="12" class="plate-fill ln ln-45" stroke-width="1.3"></rect>
                  <path d="M92 266h50M92 288h50M92 310h30" class="ln ln-22" stroke-width="1.2"></path>
                  <path d="M160 288h22M160 318h22" class="ln ln-45" stroke-width="1.3"></path>
                  <text x="74" y="392" class="tag">BATERÍA</text>
                </g>
                <g id="mod-pres" class="mod p-pres">
                  <circle cx="176" cy="332" r="13" class="plate-fill ln ln-45" stroke-width="1.2"></circle>
                  <path d="M176 332l7-6" class="ln ln-45" stroke-width="1.2"></path>
                  <text x="112" y="336" class="tag">PRESIÓN</text>
                </g>
                <g id="mod-uv" class="mod p-uv">
                  <path d="M286 172a24 24 0 0 1 48 0" class="plate-fill ln ln-45" stroke-width="1.3"></path>
                  <path d="M298 160a12 12 0 0 1 24 0" class="ln ln-22" stroke-width="1.1"></path>
                  <text x="344" y="162" class="tag">UV</text>
                </g>

                <rect x="192" y="174" width="236" height="218" rx="18" class="body-fill ln ln-08" stroke-width="1.6"></rect>
                <rect x="204" y="186" width="212" height="194" rx="12" class="ln ln-22" stroke-width="1"></rect>
                <path d="M222 344h84M222 356h84M222 368h52" class="ln ln-22" stroke-width="1.4" stroke-linecap="round"></path>
                <circle cx="214" cy="196" r="2.5" fill="currentColor" opacity="0.3"></circle>
                <circle cx="406" cy="196" r="2.5" fill="currentColor" opacity="0.3"></circle>
                <circle cx="214" cy="370" r="2.5" fill="currentColor" opacity="0.3"></circle>
                <circle cx="406" cy="370" r="2.5" fill="currentColor" opacity="0.3"></circle>
                <rect x="222" y="210" width="120" height="30" rx="4" class="ln ln-22" stroke-width="1"></rect>
                <text x="234" y="230" style="font-size: 11px; letter-spacing: 0.16em; fill: currentColor; opacity: 0.45;">BITÁCORA</text>
                <text x="352" y="230" style="font-family: var(--font-mono); font-size: 10px; fill: currentColor; opacity: 0.3;">B—01</text>
                <circle cx="394" cy="224" r="13" fill="var(--lp-ok)" class="led-halo"></circle>
                <circle cx="394" cy="224" r="5" fill="var(--lp-ok)"></circle>
                <path d="M296 392v16h28v-16" class="ln ln-45" stroke-width="1.3"></path>
                <path d="M310 408c0 26-42 30-42 56" class="ln ln-22" stroke-width="1.2"></path>

                <g id="mod-temp" class="mod p-temp">
                  <rect x="428" y="208" width="58" height="60" rx="12" class="body-fill ln ln-45" stroke-width="1.3"></rect>
                  <path d="M442 226h30M442 240h30" class="ln ln-22" stroke-width="1.2"></path>
                  <text x="440" y="200" class="tag">°C</text>
                </g>
                <g id="mod-hum" class="mod p-hum">
                  <rect x="428" y="278" width="58" height="60" rx="12" class="body-fill ln ln-45" stroke-width="1.3"></rect>
                  <circle cx="457" cy="308" r="12" class="ln ln-22" stroke-width="1.2"></circle>
                  <text x="440" y="356" class="tag">% HR</text>
                </g>
                <g id="mod-co2" class="mod p-co2">
                  <rect x="236" y="400" width="148" height="52" rx="12" class="body-fill ln ln-45" stroke-width="1.3"></rect>
                  <circle cx="272" cy="426" r="13" class="ln ln-45" stroke-width="1.2"></circle>
                  <path d="M300 418h64M300 432h42" class="ln ln-22" stroke-width="1.2"></path>
                  <text x="236" y="476" class="tag">CO₂</text>
                </g>
                <g id="mod-suelo" class="mod p-suelo">
                  <path d="M268 464c-30 10-52 22-52 40" class="ln ln-22" stroke-width="1.2"></path>
                  <path d="M206 504h22l-11 34z" class="body-fill ln ln-45" stroke-width="1.3"></path>
                  <text x="116" y="512" class="tag">SUELO</text>
                </g>
              </g>

              <!-- segundo equipo: gateway LoRa -->
              <g id="unit-gw" class="unit-gw">
                <g class="enlace">
                  <path d="M520 300a26 26 0 0 1 0 36M540 288a44 44 0 0 1 0 60M560 276a62 62 0 0 1 0 84" class="ln ln-45" stroke-width="1.3" stroke-linecap="round"></path>
                </g>
                <ellipse cx="672" cy="470" rx="86" ry="10" fill="currentColor" opacity="0.05"></ellipse>
                <path d="M672 330V182" class="ln ln-45" stroke-width="1.5"></path>
                <circle cx="672" cy="176" r="6" class="ln ln-08" stroke-width="1.4"></circle>
                <path d="M654 196h36M658 214h28" class="ln ln-45" stroke-width="1.3"></path>
                <path d="M646 158a36 36 0 0 1 52 0M632 140a56 56 0 0 1 80 0" class="ln ln-22" stroke-width="1.2" stroke-linecap="round"></path>
                <rect x="602" y="330" width="140" height="116" rx="14" class="body-fill ln ln-08" stroke-width="1.6"></rect>
                <rect x="612" y="340" width="120" height="96" rx="9" class="ln ln-22" stroke-width="1"></rect>
                <path d="M626 412h44M626 424h28" class="ln ln-22" stroke-width="1.3" stroke-linecap="round"></path>
                <circle cx="716" cy="356" r="9" fill="var(--lp-accent)" class="led-halo"></circle>
                <circle cx="716" cy="356" r="4" fill="var(--lp-accent)"></circle>
                <path d="M622 446v14M722 446v14" class="ln ln-45" stroke-width="1.3"></path>
                <text x="602" y="486" class="tag-fijo">GATEWAY LORA</text>
              </g>
            </g>
          </svg>
        </div>

        <div id="mide" class="mide">
          <span id="m-temp" class="m" hidden><span class="v">23,4</span><span class="k">°C</span></span>
          <span id="m-hum" class="m" hidden><span class="v">61</span><span class="k">% HR</span></span>
          <span id="m-co2" class="m" hidden><span class="v">512</span><span class="k">ppm</span></span>
          <span id="m-suelo" class="m" hidden><span class="v">38</span><span class="k">% suelo</span></span>
          <span id="m-uv" class="m" hidden><span class="v">7,2</span><span class="k">UV</span></span>
          <span id="m-pres" class="m" hidden><span class="v">1.013</span><span class="k">hPa</span></span>
          <span id="m-vacio" class="vacio">Sumá un sensor para que el equipo empiece a medir algo.</span>
        </div>
      </div>

      <div class="segm" role="group" aria-label="Qué módulos ver">
        <button type="button" id="seg-sensores" class="on" aria-pressed="true">
          <span>Sensores</span><span id="cuenta-sensores" class="cuenta"></span>
        </button>
        <button type="button" id="seg-energia" aria-pressed="false">
          <span>Energía y enlace</span><span id="cuenta-energia" class="cuenta"></span>
        </button>
      </div>

      <div id="rail-energia" class="rail rail-energia oculto">
        <div class="rail-h"><span>Energía y enlace</span><span>USD</span></div>
        <div class="chips">
          <button type="button" id="chip-bat" class="chip" aria-pressed="false" data-modulo="bat">
            <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><rect x="3" y="8" width="15" height="9" rx="2.5"></rect><path d="M21 11.2v2.6M7 11v3M11 11v3"></path></svg>
            <span class="txt"><span class="nm">Batería</span><span class="un">autonomía</span></span>
            <span id="pr-bat" class="pr">+ US$ 10</span>
          </button>
          <button type="button" id="chip-solar" class="chip" aria-pressed="false" data-modulo="solar">
            <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><rect x="3" y="5" width="18" height="10" rx="1.5"></rect><path d="M3 10h18M9 5v10M15 5v10M12 15v4M8.5 19h7"></path></svg>
            <span class="txt"><span class="nm">Panel solar</span><span class="un">sin red eléctrica</span></span>
            <span id="pr-solar" class="pr">+ US$ 25</span>
          </button>
          <button type="button" id="chip-lora" class="chip" aria-pressed="false" data-modulo="lora">
            <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="2"></circle><path d="M8.6 8.6a4.8 4.8 0 0 0 0 6.8M15.4 8.6a4.8 4.8 0 0 1 0 6.8"></path><path d="M5.9 5.9a8.6 8.6 0 0 0 0 12.2M18.1 5.9a8.6 8.6 0 0 1 0 12.2"></path></svg>
            <span class="txt"><span class="nm">LoRa</span><span class="un">radio + gateway</span></span>
            <span id="pr-lora" class="pr">+ US$ 100</span>
          </button>
          <button type="button" id="chip-gw" class="chip" style="cursor: default; opacity: 0.45;" disabled aria-disabled="true">
            <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><rect x="4" y="13" width="16" height="7" rx="2"></rect><path d="M12 13V4M8.5 7a5 5 0 0 1 7 0"></path></svg>
            <span class="txt"><span class="nm">Gateway LoRa</span><span id="gw-estado" class="un">sólo con LoRa</span></span>
            <span class="pr">US$ 65</span>
          </button>
          <button type="button" id="chip-cel" class="chip" aria-pressed="false" data-modulo="cel">
            <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M4 19v-4M9.3 19v-8M14.6 19v-12M20 19V5"></path></svg>
            <span class="txt"><span class="nm">Celular</span><span class="un">sin wi-fi</span></span>
            <span id="pr-cel" class="pr">+ US$ 30</span>
          </button>
        </div>
        <p style="margin-top: 14px; font-size: 12px; line-height: 1.7; color: var(--lp-faint);">Wi-Fi y equipo base vienen en todos los equipos: US$ 79. Al elegir LoRa entra también el gateway, que es un segundo equipo.</p>
      </div>
    </div>

    <div id="sumbar" class="sumbar">
      <span class="lbl">Tu equipo</span>
      <span id="resumen-texto" class="list">Equipo base, todavía sin módulos</span>
      <span class="price">
        <span id="delta" class="delta"></span>
        <span id="total" class="n">US$ 79</span>
        <span class="r">estimado · a confirmar</span>
      </span>
      <a href="#cierre" class="cta cta-solid">Pedir este equipo</a>
    </div>

    <p class="flow">
      <span><b>Lo armamos</b> con tu configuración</span><span>→</span>
      <span><b>te llega</b> listo</span><span>→</span>
      <span><b>lo conectás</b> al Wi-Fi desde el navegador</span><span>→</span>
      <span><b>empieza a medir</b></span>
    </p>
  </section>
</div>

<script>
  import '../../scripts/configurador'
</script>
