---
// Prólogo de Registro.astro, que lo monta dentro de su banda.
// El avance lo manda el scroll: la sección ocupa un tramo alto (.watch-pista)
// y el contenido queda fijo adentro mientras se recorre. El trazo entero está
// en el DOM y se revela con un clip cuyo ancho es la posición del scroll.
// StatusPill se resuelve con las dos variantes en el DOM (normal/critical)
// alternadas por hidden, igual que el toggle de tema.
import PastillaEstado from '../datos/PastillaEstado.astro'
import { DIBUJADO_INICIAL, TRAMO_ALERTA, TRAMO_CALMA, UMBRAL, VISTA, Y_UMBRAL, valorEn } from '../../datos/guardia'

const fmt = new Intl.NumberFormat('es-AR', { minimumFractionDigits: 1, maximumFractionDigits: 1 })
const inicial = valorEn(DIBUJADO_INICIAL)
---

<section id="guardia" class="watch stage">
  <div id="watch-pista" class="watch-pista">
    <div class="watch-fijo">
      <h2 id="watch-titulo" class="say">Casi siempre, no pasa nada.</h2>

      <div class="watch-graf" style={`--y-umbral: ${((Y_UMBRAL / VISTA.alto) * 100).toFixed(2)}%`}>
        <svg class="watch-svg" viewBox={`0 0 ${VISTA.ancho} ${VISTA.alto}`} preserveAspectRatio="none" fill="none" aria-hidden="true">
          <defs>
            <clipPath id="watch-revela" clipPathUnits="userSpaceOnUse">
              <rect id="watch-clip" x="0" y="0" width="0" height={VISTA.alto}></rect>
            </clipPath>
          </defs>
          <rect class="zona" x="0" y="0" width={VISTA.ancho} height={Y_UMBRAL}></rect>
          <line x1="0" y1={Y_UMBRAL} x2={VISTA.ancho} y2={Y_UMBRAL} class="limit"></line>
          <g clip-path="url(#watch-revela)">
            <polyline class="trace trace-calm" points={TRAMO_CALMA}></polyline>
            <polyline class="trace trace-alert" points={TRAMO_ALERTA}></polyline>
          </g>
          <line id="watch-guia" class="guia" x1="0" y1="0" x2="0" y2={VISTA.alto}></line>
          <ellipse id="watch-cabeza" class="cabeza" cx="0" cy="0" rx="5" ry="5"></ellipse>
        </svg>
        <span class="micro watch-umbral">umbral {fmt.format(UMBRAL)} °C</span>
      </div>

      <div class="watch-cols">
        <div class="watch-card">
          <div class="watch-card__top">
            <span class="watch-card__name">Cámara 1</span>
            <PastillaEstado id="pastilla-normal" estado="normal" etiqueta="En línea" pill />
            <PastillaEstado id="pastilla-critical" estado="critical" etiqueta="Alerta" pill hidden />
          </div>
          <div class="watch-read read">
            <span id="watch-valor" class="big">{fmt.format(inicial)}</span><span class="unit">°C</span>
          </div>
        </div>
        <div style="flex: 1; min-width: 260px;">
          <p id="watch-nota" class="note">Mientras el valor esté donde tiene que estar, acá no pasa nada.</p>
          <div class="alerta-card">
            <div class="t">Alerta enviada <span class="sep">·</span> Cámara 1</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import '../../scripts/guardia'
</script>
