---
// La sección donde se ve la app. Una placa grande con la pantalla completa
// (equipos, gráfico y avisos) y abajo lo que sale del historial: el CSV y el
// informe. Todo es dato fijo resuelto en build; sólo el bloque del informe
// (vacío/generando/listo) es interactivo — scripts/informe.ts.
import FilaEquipo from '../datos/FilaEquipo.astro'
import SerieTemporal from '../datos/SerieTemporal.astro'
import EventoAlerta from '../datos/EventoAlerta.astro'
import { HISTORIAL } from '../../datos/eventos'

const serie = [4.4, 4.3, 4.5, 4.2, 4.1, 4.3, 4.6, 5.1, 4.9, 4.7, 4.5, null, 4.6, 5.4, 6.2, 7.1, 8.4, 9.2, 8.1, 6.4, 5.2, 4.6]
const etiquetas: Record<number, string> = { 0: '12:00', 6: '14:00', 13: '16:00', 21: '18:30' }
const datosSerie = serie.map((value, i) => ({ value, label: etiquetas[i] }))
---

<div class="band-alt">
  <section class="soft-sec stage">
    <div class="reg-head">
      <h2 class="say">Todo lo que mide,<br>queda registrado.</h2>
      <div class="reg-head__lado">
        <p class="note">
          El equipo mide y manda; la app lo muestra y lo guarda. Arriba, lo que está pasando ahora.
          Abajo, todo lo que ya pasó: el historial completo, el CSV y el informe que te piden en una auditoría.
        </p>
        <div class="narra">
          <span>Monitorea</span><span class="flecha">→</span>
          <span>Registra</span><span class="flecha">→</span>
          <span>Detecta</span><span class="flecha">→</span>
          <span>Notifica</span><span class="flecha">→</span>
          <span id="paso-documenta">Documenta</span>
        </div>
      </div>
    </div>

    <div class="tablero">
      <div class="tab-equipos">
        <div class="cap">Equipos</div>
        <div class="tab-lista">
          <FilaEquipo
            nombre="Cámara 1" ubicacion="Depósito norte" estado="normal" etiquetaEstado="Normal" ultimaVez="hace 12 s"
            lecturas={[{ etiqueta: 'Temp', valor: 4.9, unidad: '°C' }, { etiqueta: 'HR', valor: 85, unidad: '%', decimales: 0 }]}
          />
          <FilaEquipo
            nombre="Cámara 2" ubicacion="Depósito sur" estado="critical" etiquetaEstado="Fuera de rango" ultimaVez="hace 40 s" alertas={1}
            lecturas={[{ etiqueta: 'Temp', valor: 9.4, unidad: '°C', tono: 'critical' }, { etiqueta: 'HR', valor: 84, unidad: '%', decimales: 0 }]}
          />
          <FilaEquipo
            nombre="Invernadero A" ubicacion="Lote 3" estado="attention" etiquetaEstado="Con retraso" ultimaVez="hace 43 min"
            lecturas={[{ etiqueta: 'Temp', valor: 23.8, unidad: '°C', desactualizada: true }, { etiqueta: 'HR', valor: 61, unidad: '%', decimales: 0, desactualizada: true }]}
          />
          <FilaEquipo
            nombre="Sala de máquinas" ubicacion="Planta baja" estado="critical" etiquetaEstado="Sin reportar" ultimaVez="hace 2 h 10 min"
            lecturas={[{ etiqueta: 'Temp', valor: 19.2, unidad: '°C', desactualizada: true }, { etiqueta: 'HR', valor: 44, unidad: '%', decimales: 0, desactualizada: true }]}
          />
          <FilaEquipo
            nombre="Cámara 3" ubicacion="Depósito este" estado="normal" etiquetaEstado="Normal" ultimaVez="hace 1 min"
            lecturas={[{ etiqueta: 'Temp', valor: 3.8, unidad: '°C' }, { etiqueta: 'HR', valor: 88, unidad: '%', decimales: 0 }]}
          />
          <FilaEquipo
            nombre="Antecámara" ubicacion="Recepción" estado="normal" etiquetaEstado="Normal" ultimaVez="hace 25 s"
            lecturas={[{ etiqueta: 'Temp', valor: 11.4, unidad: '°C' }, { etiqueta: 'HR', valor: 72, unidad: '%', decimales: 0 }]}
          />
        </div>
        <div class="tab-pie">6 equipos · 1 con retraso · 1 sin reportar</div>
      </div>

      <div class="tab-datos">
        <div class="tab-graf">
          <div class="tab-h">
            <span class="tab-h__tit">Cámara 1 · Temperatura</span>
            <span class="tab-h__meta">Hoy · últimas 6 h</span>
          </div>
          <SerieTemporal datos={datosSerie} unidad="°C" umbral={8} etiquetaUmbral="umbral 8,0 °C" ancho={560} alto={210} divisiones={3} />
        </div>

        <div class="tab-avisos">
          <div class="cap">Avisos</div>
          <EventoAlerta tipo="disparada" dispositivo="Cámara 2" sensor="Temperatura" valor={9.4} unidad="°C" condicion="mayor" umbral={8} cuando="hoy 17:34" />
          <EventoAlerta tipo="normalizada" dispositivo="Cámara 1" sensor="Temperatura" valor={6.4} unidad="°C" condicion="mayor" umbral={8} cuando="hoy 17:25" />
          <EventoAlerta tipo="silencio" dispositivo="Sala de máquinas" silencio="2 h 10 min" cuando="hoy 15:20" />
        </div>
      </div>
    </div>

    <div class="reg-grid">
      <div class="log">
        <span class="hilo" aria-hidden="true"></span>
        <div class="cap">Historial</div>
        <div class="log-tabla">
          <div class="log-h">
            <span>Hora</span><span>Temp °C</span><span>HR %</span><span>CO₂ ppm</span>
          </div>
          {HISTORIAL.map((f) => (
            <div class={`log-row ${f.fuera ? 'fuera' : ''}`.trim()}>
              <span class="hora">{f.h}</span>
              <span class="val val-temp">{f.temp}</span>
              <span class="val">{f.hr}</span>
              <span class="val">{f.co2}</span>
            </div>
          ))}
        </div>
        <div class="log-pie">
          <span class="mas">Cámara 1 · 18 de sept · 288 lecturas</span>
          <span class="log-csv">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12m0 0-4.5-4.5M12 15l4.5-4.5M4 19h16"></path></svg>
            Exportable en CSV
          </span>
        </div>
      </div>

      <div class="informe">
        <span class="hilo" aria-hidden="true"></span>
        <div class="inf-copy">
          <div class="cap">Informe</div>
          <p class="inf-tit">El período entero, en un PDF.</p>
          <ul class="inf-lista">
            <li>El gráfico del rango, con mínimo, máximo y promedio</li>
            <li>Cada salida de rango, con su duración</li>
            <li>Semanal o mensual, al mail, sin pedirlo</li>
          </ul>
          <button type="button" id="btn-informe" class="cta cta-line cta-sm">Generar informe</button>
        </div>

        <div class="inf-hoja">
          <div id="informe-vacio" class="placa">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8Z"></path><path d="M14 3v5h5"></path><path d="M9 13h6M9 17h4"></path></svg>
            El historial de este período, convertido en un informe.
          </div>
          <div id="informe-generando" class="placa" style="opacity: 0.5;" hidden>Armando el informe…</div>
          <div id="informe-progreso" class="progreso" hidden><i></i></div>

          <div id="informe-hoja" class="hoja" hidden>
            <div class="h-top">
              <span class="h-tick"></span>
              <span class="h-marca">BITÁCORA</span>
              <span class="h-tipo">Informe de monitoreo</span>
            </div>

            <div class="h-tit">Cámara 1 · Depósito norte</div>
            <div class="h-meta">
              <div>Período<b>12 — 18 sept 2026</b></div>
              <div>Sensor<b>Temperatura</b></div>
              <div>Rango definido<b>2,0 — 8,0 °C</b></div>
              <div>Lecturas<b>1.728</b></div>
            </div>

            <div class="h-cap">Resumen del período</div>
            <div class="h-nums">
              <div><b>5,1</b><span>PROM. °C</span></div>
              <div><b>3,8</b><span>MÍN. °C</span></div>
              <div><b>9,2</b><span>MÁX. °C</span></div>
              <div><b>2</b><span>EVENTOS</span></div>
            </div>

            <div class="h-graf">
              <svg viewBox="0 0 240 54" fill="none" preserveAspectRatio="none" aria-hidden="true">
                <line x1="0" y1="16" x2="240" y2="16" stroke="#C7544A" stroke-width="0.8" stroke-dasharray="3 4"></line>
                <polyline points="0,38 16,36 32,39 48,35 64,37 80,33 96,36 112,20 128,10 144,22 160,34 176,37 192,33 208,36 224,34 240,37" fill="none" stroke="#0A5C6B" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"></polyline>
              </svg>
            </div>

            <div class="h-cap">Eventos fuera de rango</div>
            <div class="h-tabla">
              <div class="fila mal"><span>14 sept · 14:42</span><span>9,2 °C</span><span>26 min</span></div>
              <div class="fila mal"><span>16 sept · 03:18</span><span>8,4 °C</span><span>9 min</span></div>
              <div class="fila"><span>Avisos enviados</span><span>2</span><span>3 destinatarios</span></div>
            </div>

            <div class="h-pie"><span>Generado el 18 sept 2026, 19:40</span><span>1 / 2</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>

<script>
  import '../../scripts/informe'
</script>
