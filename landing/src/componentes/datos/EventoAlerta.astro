---
// Redibujo de AlertEvent.jsx. Dos formas de aviso, como alerta_eventos:
// el cruce de umbral trae la regla, el corte de conectividad trae cuánto
// duró el silencio. Sin nombre de dispositivo: acá los tres avisos narran
// el mismo gráfico de arriba, no equipos distintos.
import MarcaEstado from './MarcaEstado.astro'

interface Props {
  tipo: 'disparada' | 'normalizada' | 'silencio'
  sensor?: string
  condicion?: 'mayor' | 'menor'
  umbral?: number
  unidad?: string
  silencio?: string
  cuando: string
}

const { tipo, sensor, condicion = 'mayor', umbral, unidad = '', silencio, cuando } = Astro.props
const estado = tipo === 'normalizada' ? 'normal' : 'critical'
const fmt = new Intl.NumberFormat('es-AR', { maximumFractionDigits: 1 })
const signo = condicion === 'mayor' ? '>' : '<'
const SUBTITULO: Record<typeof tipo, string | null> = {
  disparada: 'Alerta disparada',
  normalizada: 'Alerta normalizada',
  silencio: null,
}
---

<div class="bt-event">
  <MarcaEstado estado={estado} size={11} />
  <div class="bt-event__what">
    <span class="bt-event__title">
      {tipo === 'silencio' ? 'Dejó de reportar' : `${sensor} ${signo} ${fmt.format(umbral as number)} ${unidad}`}
    </span>
    {SUBTITULO[tipo] && <span class="bt-event__where">{SUBTITULO[tipo]}</span>}
  </div>
  {tipo === 'silencio' && <span class="bt-event__cmp">{silencio} sin datos</span>}
  <span class="bt-event__when">{cuando}</span>
</div>
