---
// Redibujo de AlertEvent.jsx. Dos formas de aviso, como alerta_eventos:
// el cruce de umbral trae valor y regla, el corte de conectividad trae
// cuánto duró el silencio.
import MarcaEstado from './MarcaEstado.astro'

interface Props {
  tipo: 'disparada' | 'normalizada' | 'silencio'
  dispositivo: string
  sensor?: string
  valor?: number
  unidad?: string
  condicion?: 'mayor' | 'menor'
  umbral?: number
  silencio?: string
  cuando: string
}

const { tipo, dispositivo, sensor, valor, unidad = '', condicion = 'mayor', umbral, silencio, cuando } = Astro.props
const estado = tipo === 'normalizada' ? 'normal' : 'critical'
const fmt = new Intl.NumberFormat('es-AR', { maximumFractionDigits: 1 })
const signo = condicion === 'mayor' ? '>' : '<'
---

<div class="bt-event">
  <MarcaEstado estado={estado} size={11} />
  <div class="bt-event__what">
    <span class="bt-event__title">
      {tipo === 'silencio' ? 'Dejó de reportar' : `${sensor} ${signo} ${fmt.format(umbral as number)} ${unidad}`}
    </span>
    <span class="bt-event__where">
      {dispositivo}{tipo === 'silencio' ? '' : ` · ${sensor}`}{tipo === 'normalizada' && ' · normalizada'}
    </span>
  </div>
  <span class="bt-event__cmp">
    {tipo === 'silencio' ? (
      <>{silencio} sin datos</>
    ) : (
      <><b>{fmt.format(valor as number)} {unidad}</b> {signo} {fmt.format(umbral as number)} {unidad}</>
    )}
  </span>
  <span class="bt-event__when">{cuando}</span>
</div>
