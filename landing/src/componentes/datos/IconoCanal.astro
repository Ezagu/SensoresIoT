---
// Los canales por los que puede llegar un aviso. El de WhatsApp es el mismo
// glifo que el botón "Hablemos" del nav.
export type Canal = 'mail' | 'whatsapp' | 'telegram'

interface Props {
  canal: Canal
  /** Para apilar los tres y alternarlos por CSS (ver el celular del hero). */
  marcado?: boolean
}

const { canal, marcado = false } = Astro.props
const dato = marcado ? { 'data-canal': canal } : {}
---

{canal === 'mail' && (
  <svg {...dato} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2.5"></rect><path d="m3.8 7.2 8.2 6 8.2-6"></path></svg>
)}
