---
// Redibujo de TimeSeries.jsx: misma matemática (padding, banda min/max,
// huecos, umbral punteado), pero corre en build — no hay <script> acá, el
// SVG sale con el polyline ya calculado. Colores remapeados a --lp-*.
interface Punto {
  value: number | null
  label?: string
  min?: number
  max?: number
}

interface Props {
  datos: Punto[]
  unidad?: string
  umbral?: number
  etiquetaUmbral?: string
  ancho?: number
  alto?: number
  decimales?: number
}

const { datos, unidad = '', umbral, etiquetaUmbral, ancho = 720, alto = 200, decimales = 1 } = Astro.props

const padL = 44
const padR = 12
const padT = 10
const padB = 20

const vals: number[] = []
for (const p of datos) if (p.value !== null && p.value !== undefined) vals.push(p.value)
if (umbral !== undefined && umbral !== null) vals.push(umbral)
const lo = vals.length ? Math.min(...vals) : 0
const hi = vals.length ? Math.max(...vals) : 1
const pad = (hi - lo || 1) * 0.12
const min = lo - pad
const max = hi + pad

const x = (i: number) => padL + (i / Math.max(1, datos.length - 1)) * (ancho - padL - padR)
const y = (v: number) => padT + (1 - (v - min) / (max - min)) * (alto - padT - padB)

const segs: Punto[][] = []
let cur: Punto[] = []
const gaps: number[] = []
datos.forEach((p, i) => {
  const empty = p.value === null || p.value === undefined
  if (empty) {
    if (cur.length) segs.push(cur)
    cur = []
    gaps.push(i)
  } else {
    cur.push(p)
  }
})
if (cur.length) segs.push(cur)

const linea = (seg: Punto[]) =>
  seg.map((p) => `${x(datos.indexOf(p)).toFixed(1)},${y(p.value as number).toFixed(1)}`).join(' ')

const ticks = 4
const tickVals = Array.from({ length: ticks + 1 }, (_, i) => min + ((max - min) * i) / ticks)
const fmtN = new Intl.NumberFormat('es-AR', { minimumFractionDigits: decimales, maximumFractionDigits: decimales })
const anchoTramo = (ancho - padL - padR) / Math.max(1, datos.length - 1)
const labelled = datos.map((p, i) => ({ p, i })).filter(({ p }) => p.label)
---

<svg class="bt-chart" viewBox={`0 0 ${ancho} ${alto}`} role="img" aria-label={`Serie temporal${unidad ? ` en ${unidad}` : ''}`}>
  {tickVals.map((v) => (
    <g>
      <line x1={padL} x2={ancho - padR} y1={y(v)} y2={y(v)} stroke="var(--lp-line-soft)" stroke-width="1" />
      <text class="bt-chart__axis-y" x={padL - 8} y={y(v) + 3} text-anchor="end">{fmtN.format(v)}</text>
    </g>
  ))}
  {gaps.map((i) => (
    <rect x={x(i) - anchoTramo / 2} y={padT} width={anchoTramo} height={alto - padT - padB} fill="var(--lp-plate)" />
  ))}
  {/* Banda min/max: sólo cuando el punto la trae. Los datos de esta landing
      (serieVals del mockup) no tienen min/max, así que acá no dibuja nada —
      igual que el original con band=true pero sin esos campos. */}
  {segs.map((s) =>
    s.some((p) => p.min !== undefined) ? (
      <path
        d={`M${s.map((p) => `${x(datos.indexOf(p)).toFixed(1)},${y(p.max ?? (p.value as number)).toFixed(1)}`).join('L')}L${s
          .slice()
          .reverse()
          .map((p) => `${x(datos.indexOf(p)).toFixed(1)},${y(p.min ?? (p.value as number)).toFixed(1)}`)
          .join('L')}Z`}
        fill="var(--lp-accent-wash)"
      />
    ) : null,
  )}
  {umbral !== undefined && umbral !== null && (
    <g>
      <line x1={padL} x2={ancho - padR} y1={y(umbral)} y2={y(umbral)} stroke="var(--lp-warn-mark)" stroke-width="1" stroke-dasharray="4 3" />
      <text class="bt-chart__axis-y" x={ancho - padR} y={y(umbral) - 5} text-anchor="end" fill="var(--lp-warn-mark)">
        {etiquetaUmbral || `umbral ${fmtN.format(umbral)} ${unidad}`}
      </text>
    </g>
  )}
  {segs.map((s) => (
    <polyline points={linea(s)} fill="none" stroke="var(--lp-accent)" stroke-width="1.75" stroke-linejoin="round" stroke-linecap="round" />
  ))}
  <line x1={padL} x2={ancho - padR} y1={alto - padB} y2={alto - padB} stroke="var(--lp-faint)" stroke-width="1" />
  {labelled.map(({ p, i }) => (
    <text class="bt-chart__axis-y" x={x(i)} y={alto - 6} text-anchor="middle">{p.label}</text>
  ))}
</svg>
