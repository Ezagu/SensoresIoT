---
import Base from '../layouts/Base.astro'
import Nav from '../componentes/layout/Nav.astro'
import Pie from '../componentes/layout/Pie.astro'
import Hero from '../componentes/secciones/Hero.astro'
import Configurador from '../componentes/secciones/Configurador.astro'
import Ambientes from '../componentes/secciones/Ambientes.astro'
import Registro from '../componentes/secciones/Registro.astro'
import Planes from '../componentes/secciones/Planes.astro'
import Preguntas from '../componentes/secciones/Preguntas.astro'
import Contacto from '../componentes/secciones/Contacto.astro'
import Cierre from '../componentes/secciones/Cierre.astro'
---

<Base>
  <div class="lp">
    <a class="saltar" href="#contenido">Ir al contenido</a>
    <Nav />
    <main id="contenido">
      <Hero />
      <Registro />
      <Ambientes />
      <Configurador />
      <Planes />
      <Preguntas />
      <Contacto />
      <Cierre />
    </main>
    <Pie />
  </div>
</Base>
